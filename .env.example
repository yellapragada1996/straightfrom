# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Dev uses the straightfrom-dev Supabase project and Stripe TEST keys.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | production. db:seed only runs in development (it wipes the app tables).
APP_ENV=development

# --- Supabase (dashboard → Connect) ---
NEXT_PUBLIC_SUPABASE_URL=              # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # sb_publishable_... (safe in the browser: auth only)
SUPABASE_SECRET_KEY=                   # sb_secret_...  (server only, never in the browser)
DATABASE_URL=                          # Transaction pooler, port 6543 (app runtime)
DATABASE_URL_DIRECT=                   # Session pooler, port 5432 (migrations)

# --- Later phases ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM="StraightFrom <orders@mail.straightfrom.co>"
# ADMIN_EMAILS=
# CRON_SECRET=
# SENTRY_DSN=
